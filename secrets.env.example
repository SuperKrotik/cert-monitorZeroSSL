# Секреты cert_monitor (Docker env_file: /etc/cert-monitor/secrets.env).
# Заполните реальные значения и сделайте chmod 600.
DUCKDNS_TOKEN=replace_me
ZEROSSL_API_KEY=replace_me
ZEROSSL_EAB_KID=replace_me
ZEROSSL_EAB_HMAC_KEY=replace_me

# Отправка писем через российский SMTP-сервис SMTP.BZ (smtp.bz) - бесплатный тариф, доступен из РФ.
# Данные для подключения берутся из ЛК SMTP.BZ -> "Подключение и квота".
SMTP_HOST=smtp.smtp.bz
SMTP_PORT=2525
SMTP_USERNAME=replace_me@duckdns.org
SMTP_APP_PASSWORD=replace_me
# Куда слать уведомления (личные адреса, можно несколько через запятую).
NOTIFY_TO=you@example.com

# Cloud.ru (опционально; для баланса и расходов в еженедельном отчёте)
CLOUDRU_KEY_ID=replace_me
CLOUDRU_SECRET=replace_me
CLOUDRU_AGREEMENT_ID=replace_me