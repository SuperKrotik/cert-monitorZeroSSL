[Unit]
Description=Cert Monitor: DuckDNS + ZeroSSL certificate tracking and renewal
Documentation=file:///opt/cert-monitor/README.md
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
User=certmon
Group=certmon
ExecStart=/usr/bin/python3 -m cert_monitor --config /etc/cert-monitor/config.yaml
WorkingDirectory=/opt/cert-monitor
Environment=PYTHONUNBUFFERED=1
# Секреты приходят из EnvironmentFile (не попадают в process list)
EnvironmentFile=-/etc/cert-monitor/secrets.env
# Нестандартные пути (переопределить при необходимости):
# Environment=CERTMON_CONFIG=/etc/cert-monitor/config.yaml
ReadWritePaths=/etc/cert-monitor /var/lib/cert-monitor /var/log/cert-monitor /etc/letsencrypt /var/www/certbot
TimeoutStartSec=900
Nice=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
